{
  "name": "bagh-one-restaurant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/src/server.js",
    "server:dev": "nodemon server/src/server.js",
    "build": "prisma generate --schema server/prisma/schema.prisma && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "prisma:generate": "prisma generate --schema server/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "prisma:seed": "prisma db seed --schema server/prisma/schema.prisma"
  },
  "prisma": {
    "seed": "node server/prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "nodemon": "^3.1.14",
    "oxlint": "^1.79.0",
    "prisma": "^6.19.3",
    "vite": "^8.2.2"
  },
  "allowScripts": {
    "@prisma/client@6.12.0": true,
    "bcrypt@6.0.0": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
